# Job API Keys
# Jooble API (https://jooble.org/api/)
JOOBLE_API_KEY=your_jooble_api_key_here
# Optional regional domain (e.g., uk.jooble.org, ca.jooble.org, de.jooble.org)
# JOOBLE_API_DOMAIN=jooble.org

# USAJobs API (https://developer.usajobs.gov/)
USAJOBS_API_KEY=your_usajobs_api_key_here
USAJOBS_EMAIL=your_email@example.com

# Himalayas Remote Jobs API (https://himalayas.app/docs/remote-jobs-api - key is optional)
# HIMALAYAS_API_KEY=your_himalayas_api_key_here

# The Muse API (https://www.themuse.com/developers/api/v2 - key is optional)
# THEMUSE_API_KEY=your_themuse_api_key_here

# Turso Database Configuration
# Obtain your database URL and auth token from https://turso.tech/
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token
